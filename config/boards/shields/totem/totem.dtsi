#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = &totem_physical_layout;
    };

    totem_physical_layout: totem_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "TOTEM";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys  //                     w   h     x    y     rot    rx    ry
            = <&key_physical_attrs 100 100   100   50       0     0     0>
            , <&key_physical_attrs 100 100   200   15       0     0     0>
            , <&key_physical_attrs 100 100   300    0       0     0     0>
            , <&key_physical_attrs 100 100   400   15       0     0     0>
            , <&key_physical_attrs 100 100   500   25       0     0     0>
            , <&key_physical_attrs 100 100   800   25       0     0     0>
            , <&key_physical_attrs 100 100   900   15       0     0     0>
            , <&key_physical_attrs 100 100  1000    0       0     0     0>
            , <&key_physical_attrs 100 100  1100   15       0     0     0>
            , <&key_physical_attrs 100 100  1200   50       0     0     0>
            , <&key_physical_attrs 100 100   100  150       0     0     0>
            , <&key_physical_attrs 100 100   200  115       0     0     0>
            , <&key_physical_attrs 100 100   300  100       0     0     0>
            , <&key_physical_attrs 100 100   400  115       0     0     0>
            , <&key_physical_attrs 100 100   500  125       0     0     0>
            , <&key_physical_attrs 100 100   800  125       0     0     0>
            , <&key_physical_attrs 100 100   900  115       0     0     0>
            , <&key_physical_attrs 100 100  1000  100       0     0     0>
            , <&key_physical_attrs 100 100  1100  115       0     0     0>
            , <&key_physical_attrs 100 100  1200  150       0     0     0>
            , <&key_physical_attrs 100 100     0  270       0     0     0>
            , <&key_physical_attrs 100 100   100  250       0     0     0>
            , <&key_physical_attrs 100 100   200  215       0     0     0>
            , <&key_physical_attrs 100 100   300  200       0     0     0>
            , <&key_physical_attrs 100 100   400  215       0     0     0>
            , <&key_physical_attrs 100 100   500  225       0     0     0>
            , <&key_physical_attrs 100 100   800  225       0     0     0>
            , <&key_physical_attrs 100 100   900  215       0     0     0>
            , <&key_physical_attrs 100 100  1000  200       0     0     0>
            , <&key_physical_attrs 100 100  1100  215       0     0     0>
            , <&key_physical_attrs 100 100  1200  250       0     0     0>
            , <&key_physical_attrs 100 100  1300  270       0     0     0>
            , <&key_physical_attrs 100 100   300  320       0     0     0>
            , <&key_physical_attrs 100 100   400  325       0     0     0>
            , <&key_physical_attrs 100 100   500  335       0     0     0>
            , <&key_physical_attrs 100 100   800  335       0     0     0>
            , <&key_physical_attrs 100 100   900  325       0     0     0>
            , <&key_physical_attrs 100 100  1000  320       0     0     0>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
//             | SW01  | SW02  | SW03  | SW04  | SW05  |  | SW05  | SW04  | SW03  | SW02  | SW01  |
//             | SW06  | SW07  | SW08  | SW09  | SW10  |  | SW10  | SW09  | SW08  | SW07  | SW06  | 
//      | SW16 | SW11  | SW12  | SW13  | SW14  | SW15  |  | SW15  | SW14  | SW13  | SW12  | SW11  | SW16  |
//                             | SW17  | SW18  | SW19  |  | SW19  | SW18  | SW17  | 
        map = <
                RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
                RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
        RC(3,0) RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(3,9)
                                RC(3,2) RC(3,3) RC(3,4)    RC(3,5) RC(3,6) RC(3,7)         
        >;
    };


    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        
        diode-direction = "col2row"; 
        row-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};